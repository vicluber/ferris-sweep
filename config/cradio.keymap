#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        num_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    macros {
        Luthiers: Luthiers {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(L) &kp U &kp T &kp H &kp I &kp E &kp R &kp S &kp N1 &kp DOT &kp STAR>;
            label = "LUTHIERS";
        };

        Luthiersvictor: Luthiersvictor {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(L) &kp U &kp T &kp H &kp I &kp E &kp R &kp S &kp N1 &kp DOT &kp STAR &kp V &kp I &kp C &kp T &kp O &kp R>;
            label = "LUTHIERSVICTOR";
        };
    };

    combos {
        compatible = "zmk,combos";

        esc_combo {
            bindings = <&kp ESC>;
            key-positions = <0 1>;
            timeout-ms = <50>;
        };

        enter_combo {
            bindings = <&kp ENTER>;
            key-positions = <20 21>;
            timeout-ms = <50>;
        };

        bluetooth {
            bindings = <&mo 4>;
            key-positions = <8 9>;
        };

        mouse {
            bindings = <&mo 5>;
            key-positions = <20 29>;
        };

        bspc_left {
            bindings = <&kp BSPC>;
            key-positions = <12 13>;
            timeout-ms = <50>;
        };

        bspc_right {
            bindings = <&kp BSPC>;
            key-positions = <16 17>;
            timeout-ms = <50>;
        };

        enter_right {
            bindings = <&kp ENTER>;
            key-positions = <28 29>;
            timeout-ms = <50>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q  &kp W  &kp E  &kp R    &kp T        &kp Y    &kp U  &kp I      &kp O    &kp P
&kp A  &kp S  &kp D  &kp F    &kp G        &kp H    &kp J  &kp K      &kp L    &kp RA(N)
&kp Z  &kp X  &kp C  &kp V    &kp B        &kp N    &kp M  &kp COMMA  &kp DOT  &kp QMARK
                      &mo 1  &kp LSHFT      &kp SPC  &mo 2
            >;
        };

        nav_layer {
            bindings = <
&kp PSCRN  &kp LC(LS(TAB))  &sk LC(LSHFT)  &kp LC(TAB)  &kp LC(W)      &kp PG_UP  &kp BSPC   &kp UP     &kp DEL    &caps_word
&sk LGUI   &sk LALT         &sk LSHFT    &sk LCTRL    &kp END        &kp TAB    &kp LEFT   &kp DOWN   &kp RIGHT  &kp ESC
&kp LC(Z)  &kp LC(X)        &kp LC(C)    &kp LC(V)    &kp LC(Y)      &kp PG_DN  &kp C_PREV &kp C_PP   &kp C_NEXT &kp K_APP
                                          &trans       &trans         &kp ENTER  &trans
            >;
        };

        sym_layer {
            bindings = <
&kp CARET  &kp LBKT   &kp LBRC   &kp LPAR   &kp LT        &kp GT    &kp RPAR   &kp RBRC   &kp RBKT  &kp RA(SQT)
&kp MINUS  &kp ASTRK  &kp UNDER  &kp EQUAL  &kp AT        &kp HASH  &sk LCTRL  &sk LSHFT  &sk LALT  &sk LGUI
&kp PLUS   &kp COLON  &kp FSLH   &kp SEMI   &kp PRCNT     &kp DLLR  &kp AMPS   &kp BSLH   &kp PIPE  &kp SQT
                                  &trans     &trans        &kp SPC   &trans
            >;
        };

        num_layer {
            bindings = <
&kp N1    &kp N2    &kp N3     &kp N4     &kp N5       &kp N6   &kp N7     &kp N8     &kp N9    &kp N0
&sk LGUI  &sk LALT  &sk LSHFT  &sk LCTRL  &kp F11      &kp F12  &sk LCTRL  &sk LSHFT  &sk LALT  &sk LGUI
&kp F7    &kp F5    &kp F3     &kp F1     &kp F9       &kp F8   &kp F10    &kp F2     &kp F4    &kp F6
                               &trans     &trans       &kp SPC  &trans
            >;
        };

        bluetooth_layer {
            bindings = <
&bt BT_CLR_ALL  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3    &trans  &trans  &trans  &trans  &trans
&trans          &trans        &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans
&trans          &trans        &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans
                                            &trans        &trans          &trans  &trans
            >;
        };

        mouse_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans    &msc SCRL_UP    &mkp LCLK       &mmv MOVE_UP    &mkp RCLK        &trans
&trans  &trans  &trans  &trans  &trans    &msc SCRL_DOWN  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans
&trans  &trans  &trans  &trans  &trans    &trans          &trans          &trans          &trans           &trans
                        &trans  &trans    &trans          &trans
            >;
        };
    };
};
